{
  "buildCommand": "npm run build --prefix ClickForGrow-main",
  "devCommand": "npm run dev",
  "installCommand": "npm ci --prefix ClickForGrow-main",
  "framework": "vite",
  "outputDirectory": "ClickForGrow-main/dist",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
